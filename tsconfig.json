{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Module settings for Node.js ESM projects that use a bundler/runner like tsx */
    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* Path aliases */
    // baseUrl 在 TS 7.0 會停用（新版編譯器的模組解析重寫），但 paths 目前仍然需要它才能運作
    // （沒有原生替代方案）——先用 ignoreDeprecations 消掉警告，之後 TS 團隊提供替代寫法再遷移。
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Build options */
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
