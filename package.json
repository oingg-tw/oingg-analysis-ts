{
  "name": "oingg-analysis-ts",
  "version": "1.0.0",
  "description": "Financial ratio calculations (ROE, ...) computed from oingg-mops-ts's ingested quarterly report data.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run --project unit --project contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:contract:update": "vitest run --project contract -u",
    "test:integration": "vitest run --project integration",
    "test:flaky": "vitest run --project flaky",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p tests/tsconfig.json",
    "verify:equivalence": "tsx scripts/verifyMetricEquivalencePit.ts",
    "lint": "oxlint --type-aware src/ scripts/ tests/",
    "lint:fix": "oxlint --type-aware --fix src/ scripts/ tests/",
    "lint:deps": "depcruise src scripts tests --config .dependency-cruiser.cjs",
    "lint:deps:graph": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\" --output-type mermaid --output-to docs/deps.mmd",
    "batch:compute": "tsx scripts/batchComputeIndicators.ts",
    "batch:types": "tsc --noEmit -p scripts/tsconfig.json",
    "postinstall": "prisma generate --schema=prisma/analysis/schema.prisma && prisma generate --schema=prisma/mopsExport/schema.prisma && prisma generate --schema=prisma/govExport/schema.prisma && prisma generate --schema=prisma/tpexExport/schema.prisma && prisma generate --schema=prisma/sitcaExport/schema.prisma && prisma generate --schema=prisma/twseExport/schema.prisma && prisma generate --schema=prisma/playwrightExport/schema.prisma",
    "prisma:analysis:studio": "prisma studio --schema=prisma/analysis/schema.prisma",
    "prisma:mopsExport:pull": "prisma db pull --schema=prisma/mopsExport/schema.prisma",
    "prisma:mopsExport:studio": "prisma studio --schema=prisma/mopsExport/schema.prisma",
    "prisma:govExport:pull": "prisma db pull --schema=prisma/govExport/schema.prisma",
    "prisma:govExport:studio": "prisma studio --schema=prisma/govExport/schema.prisma",
    "prisma:playwrightExport:pull": "prisma db pull --schema=prisma/playwrightExport/schema.prisma",
    "prisma:playwrightExport:studio": "prisma studio --schema=prisma/playwrightExport/schema.prisma",
    "prisma:tpexExport:pull": "prisma db pull --schema=prisma/tpexExport/schema.prisma",
    "prisma:tpexExport:studio": "prisma studio --schema=prisma/tpexExport/schema.prisma",
    "prisma:twseExport:pull": "prisma db pull --schema=prisma/twseExport/schema.prisma",
    "prisma:twseExport:studio": "prisma studio --schema=prisma/twseExport/schema.prisma",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.24.0",
  "imports": {
    "#generated/*": "./generated/*/index.js"
  },
  "prisma": {
    "schema": "prisma/analysis/schema.prisma"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@cortex-js/compute-engine": "^0.126.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "ultimate-express": "^2.0.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.3.1",
    "husky": "^9.1.7",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-morph": "^28.0.0",
    "tsc-alias": "^1.9.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
