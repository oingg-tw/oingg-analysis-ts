{
  "name": "oingg-analysis-ts",
  "version": "1.0.0",
  "description": "Financial ratio calculations (ROE, ...) computed from oingg-mops-ts's ingested quarterly report data.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "test": "tsx --test tests/**/*.test.ts",
    "test:types": "tsc --noEmit -p tests/tsconfig.json",
    "batch:compute": "tsx scripts/batchComputeIndicators.ts",
    "sync:curated": "tsx scripts/syncCuratedDatasets.ts",
    "batch:types": "tsc --noEmit -p scripts/tsconfig.json",
    "postinstall": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/analysis/schema.prisma && prisma generate --schema=prisma/twse/schema.prisma && prisma generate --schema=prisma/gov/schema.prisma && prisma generate --schema=prisma/mopsExport/schema.prisma && prisma generate --schema=prisma/govExport/schema.prisma && prisma generate --schema=prisma/tpexExport/schema.prisma",
    "prisma:analysis:migrate": "prisma migrate dev --schema=prisma/analysis/schema.prisma",
    "prisma:analysis:studio": "prisma studio --schema=prisma/analysis/schema.prisma",
    "prisma:twse:pull": "prisma db pull --schema=prisma/twse/schema.prisma",
    "prisma:twse:studio": "prisma studio --schema=prisma/twse/schema.prisma",
    "prisma:gov:pull": "prisma db pull --schema=prisma/gov/schema.prisma",
    "prisma:gov:studio": "prisma studio --schema=prisma/gov/schema.prisma",
    "prisma:mopsExport:pull": "prisma db pull --schema=prisma/mopsExport/schema.prisma",
    "prisma:mopsExport:studio": "prisma studio --schema=prisma/mopsExport/schema.prisma",
    "prisma:govExport:pull": "prisma db pull --schema=prisma/govExport/schema.prisma",
    "prisma:govExport:studio": "prisma studio --schema=prisma/govExport/schema.prisma",
    "prisma:tpexExport:pull": "prisma db pull --schema=prisma/tpexExport/schema.prisma",
    "prisma:tpexExport:studio": "prisma studio --schema=prisma/tpexExport/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ultimate-express": "^2.0.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.22.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3"
  }
}
