/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 2026-09-04 接進 securities/excludeFullDelivery 了——判斷依據是「symbol 有沒有出現在
/// 最新一個 trade_date」，不是 periodicCallAuctionTrading 這個欄位值（那是分盤集合競價，
/// 「改為人工管理」的其中一種措施，不是全額交割股本身的旗標），見
/// src/shared/sourceData/companyProfile.ts 的 getFullDeliverySymbolSets。
view ChangedTradingMethod {
  symbol                       String?
  tradeDate                    DateTime? @map("trade_date") @db.Date
  periodicCallAuctionTrading   Boolean?  @map("periodic_call_auction_trading")

  @@map("changed_trading_method")
  @@ignore
  @@schema("export")
}
