// 本 schema 只用來讀 oingg-twse 的 export schema（不是 public schema，那個在 ../twse/schema.prisma）
// ——2026-09-03 twse-ts 擴大 export schema 涵蓋 daily_price/daily_valuation/daily_taiex_index/
// company_profile/foreign_holding/margin_balance 這 6 張（跟原本就有的 monthly_revenue/
// volume_top20/disposed_stock/attention_history_note/price_limit_range/material_announcement/
// isin_securities 7 張放在一起），並且發了一組全新 Neon 專案上的 etl_reader role（實體隔離，
// 不是同專案換角色，host 是 ep-summer-surf，跟舊的 owner 帳號 ep-damp-butterfly 不同），
// 只能 SELECT export schema，已實測驗證過連 public schema 都會被拒絕（permission denied）。
// 連線用 .env 的 TWSE_EXPORT_DATABASE_URL / TWSE_EXPORT_DIRECT_URL。
//
// 這是收斂舊 owner 帳號（TWSE_DATABASE_URL，見 ../twse/schema.prisma 開頭的說明）的目標連線——
// 跟 mops/gov 一樣，view 沒有資料庫層級的唯一鍵，一律 @@ignore、查詢走 $queryRaw，即使欄位
// 形狀上看起來有自然鍵（例如 daily_price 的 symbol+trade_date）也不例外，跟
// prisma/mopsExport/schema.prisma 的 QuarterlyIncomeStatement 同一個先例。
//
// 2026-09-03 db pull 內省實測跟原本手動猜的形狀有幾處落差，以內省結果為準：
// - foreign_holding/margin_balance 實際欄位比 ../twse/schema.prisma 鏡像的還多（原始表本來就有
//   rank/available_shares/margin_buy/margin_sell 等欄位，只是 public schema 那邊當初刻意只鏡像
//   排行用得到的欄位）——這裡列出全部欄位，之後要用再挑。
// - daily_valuation 多一個 updated_at。
// - changed_trading_method 的旗標欄位其實叫 periodic_call_auction_trading（分盤集合競價），
//   不是先前談話紀錄假設的 altered_trading——全額交割股排除邏輯要接的時候要用這個真正欄位名。
//
// 異動這裡的 model 後，重新跑 `npx prisma db pull --schema=prisma/twseExport/schema.prisma`
// 內省，這個 schema 由 twse-ts 擁有，本服務永遠不對它跑 migrate。

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/twse-export-client"
  previewFeatures = ["views"]
}

// Prisma 7：driver adapter 架構下 datasource 不再放連線字串，見
// src/adapters/prisma/twseExportClient.ts、prisma.config.ts 的說明。
datasource db {
  provider = "postgresql"
  schemas  = ["export"]
}

// 握手表——見契約第二部分。跟 twse-ts 的日批次顆粒度一致（不是逐公司 run）。
model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String
  dataDate    DateTime @map("data_date") @db.Date
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  rowCount    Int      @map("row_count")
  status      String // 'success' | 'partial' | 'failed'

  @@index([dataset, dataDate])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 欄位形狀比照 ../twse/schema.prisma 的 DailyPrice（原本是 public schema 的 model）。
view DailyPrice {
  symbol      String?
  tradeDate   DateTime? @map("trade_date") @db.Date
  open        Decimal?  @db.Decimal(10, 4)
  high        Decimal?  @db.Decimal(10, 4)
  low         Decimal?  @db.Decimal(10, 4)
  close       Decimal?  @db.Decimal(10, 4)
  volume      BigInt?
  turnover    BigInt?
  transaction BigInt?
  monthlyAvg  Decimal?  @map("monthly_avg") @db.Decimal(10, 4)

  @@map("daily_price")
  @@ignore
  @@schema("export")
}

