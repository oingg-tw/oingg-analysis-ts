generator client {
  provider = "prisma-client-js"
  output   = "../../generated/gov-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("GOV_DATABASE_URL")
  directUrl = env("GOV_DIRECT_URL")
}

// 10年期政府公債次級市場殖利率（月資料）——來源是央行統計資料庫 EG43M01en（資本市場利率）
// 第 20 欄「Bond market - 10-year gov't bond rates in secondary market」，2026-08-28 接上，
// 用來當 Greenwald_EPV/CAPM 的無風險利率代理。yieldRate 單位是百分比（例如 1.234 代表 1.234%）。
// 這張表的定義/寫入由另一支負責 ingest 的服務管理，本服務只讀，不要對它跑 prisma migrate。
model MonthlyGovBondYield10y {
  year      Int
  month     Int
  yieldRate Decimal  @map("yield_rate") @db.Decimal(8, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([year, month])
  @@map("monthly_gov_bond_yield_10y")
}
