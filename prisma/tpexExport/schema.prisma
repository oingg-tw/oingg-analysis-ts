// 本 schema 只用來讀 oingg-tpex-ts 的 export schema——2026-09-01 接上，dev/prod 連線用
// .env 的 TPEX_EXPORT_DATABASE_URL_DEV / TPEX_EXPORT_DATABASE_URL_PROD。
//
// 跟 sitca-ts 同一種模式：tpex-ts 給的是 dev/prod 兩個獨立 Neon 專案，不是同一個專案的
// pooler/direct 兩種連線方式——這裡的 datasource url 固定指到 _DEV，只給 `prisma db pull`/
// `generate` 這類 CLI 操作使用；實際 runtime 要連 dev 還是 prod，由
// src/adapters/prisma/tpexExportClient.ts 依照 config.isProduction 動態決定。
//
// 2026-09-01 這次擴大：發現本服務主程式原本讀 tpex 的 prisma/tpex/schema.prisma（public
// schema 唯讀鏡像）指向的其實是 tpex-ts 的 **dev** 環境（另一組帳號，不是 etl_reader），資料
// 停在 2024-08-20，遠比 prod 舊（prod 的 daily_valuation 新到 2026-08-31）——問過 tpex-ts 後，
// 他們選擇把 export schema 擴大成含 daily_price、company_profile（比照 daily_valuation
// 同樣走 etl_reader 唯讀、dev/prod 分流），讓本服務整個切過來，退休原本那組舊帳號
// （TPEX_DATABASE_URL/TPEX_DIRECT_URL、prisma/tpex/schema.prisma 之後會移除）。
//
// company_profile 只鏡像查公司名稱用得到的欄位（symbol/name/shortName/market），不是全部
// 欄位都留——市場別 market 是新欄位（上櫃/興櫃），tpex-ts 說明用這個欄位分辨，但本服務目前
// 沒有需要分辨市場別的地方，先留著備用。
//
// export.daily_price/daily_valuation 都是逐日整批同步（IngestionRun 顆粒度是「一個 dataset、
// 一天」），company_profile 是快照表，沒有對應的 ingestion_runs 紀錄（tpex-ts 說明：快照表
// 沒有 data_date 概念）。
//
// 這幾張 view 都沒有唯一識別欄位，Prisma Client 不會產生 model 存取子（@@ignore），查詢一律走
// $queryRaw。異動這裡的 model 後，重新跑 `npx prisma db pull --schema=prisma/tpexExport/schema.prisma`
// 內省，這個 schema 由 tpex-ts 擁有，本服務永遠不對它跑 migrate——內省後记得把 view 名稱/欄位
// 手動改回 PascalCase model 名稱 + camelCase 欄位。
//
// 2026-09-01 tpex-ts 比照 twse-ts 那批新 dataset，也開了上櫃版本的 5 個（monthly_revenue、
// disposed_stock、volume_top20、price_limit_range、attention_history_note）——欄位比 TWSE
// 版本精簡（例如 disposed_stock 少了 announcement_count/disposition_measures/
// link_information，volume_top20/price_limit_range 只有最核心的幾欄），這裡只鏡像 TPEx
// 實際有的欄位，不是照抄 TWSE 那份補空欄位。刻意沒開 foreign_holding（上櫃掛牌以 KY 股居多，
// 這個排行參考價值有限）。見 src/domains/market/ 底下對應功能改成 TWSE+TPEx 合併排行/清單的
// 部分。dev 已經有一天份資料，prod 目前是空的，還在等 tpex-ts 排程/回補歷史資料。

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/tpex-export-client"
  previewFeatures = ["views"]
}

// Prisma 7：driver adapter 架構下 datasource 不再放連線字串，見
// src/adapters/prisma/tpexExportClient.ts、prisma.config.ts 的說明。dev/prod 切換邏輯也是
// 應用程式碼決定，不是 schema 層級的事。
datasource db {
  provider = "postgresql"
  schemas  = ["export"]
}

// 握手表——見契約第二部分。daily_price/daily_valuation 顆粒度是「一個 dataset、一天」，全市場
// 整批同步，不是逐公司；company_profile 快照表沒有對應紀錄。
model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String
  dataDate    DateTime @map("data_date") @db.Date
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  rowCount    Int      @map("row_count")
  status      String // 'success' | 'partial' | 'failed'

  @@unique([dataset, dataDate])
  @@index([dataset, status])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 跟 oingg-twse 的 DailyValuation 是同一種資料（上櫃版本），欄位定義完全一致。
view DailyValuation {
  symbol        String?
  tradeDate     DateTime? @map("trade_date") @db.Date
  peRatio       Decimal?  @map("pe_ratio") @db.Decimal(10, 2)
  pbRatio       Decimal?  @map("pb_ratio") @db.Decimal(10, 2)
  dividendYield Decimal?  @map("dividend_yield") @db.Decimal(10, 2)

  @@map("daily_valuation")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 跟 oingg-twse 的 DailyPrice 幾乎同一種資料（上櫃版本），沒有 monthlyAvg 欄位，跟
/// prisma/tpex/schema.prisma（即將退休）的 DailyPrice 定義一致。
view DailyPrice {
  symbol      String?
  tradeDate   DateTime? @map("trade_date") @db.Date
  open        Decimal?  @db.Decimal(10, 4)
  high        Decimal?  @db.Decimal(10, 4)
  low         Decimal?  @db.Decimal(10, 4)
  close       Decimal?  @db.Decimal(10, 4)
  volume      BigInt?
  turnover    BigInt?
  transaction BigInt?

  @@map("daily_price")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 只鏡像查公司名稱用得到的欄位，不是全部欄位都留，跟 prisma/tpex/schema.prisma（即將退休）
/// 的 CompanyProfile 做法一致，多了 market（上櫃/興櫃）備用。
view CompanyProfile {
  symbol    String?
  name      String?
  shortName String? @map("short_name")
  market    String?

  @@map("company_profile")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 月營收（上櫃版本）——欄位跟 oingg-twse 那份完全一致。
view MonthlyRevenue {
  symbol                    String?
  yearMonth                 DateTime? @map("year_month") @db.Date
  reportDate                DateTime? @map("report_date") @db.Date
  industry                  String?
  currentMonthRevenue       BigInt?   @map("current_month_revenue")
  prevMonthRevenue          BigInt?   @map("prev_month_revenue")
  lastYearSameMonthRevenue  BigInt?   @map("last_year_same_month_revenue")
  momChangePercent          Decimal?  @map("mom_change_percent") @db.Decimal(10, 4)
  yoyChangePercent          Decimal?  @map("yoy_change_percent") @db.Decimal(10, 4)
  cumulativeRevenue         BigInt?   @map("cumulative_revenue")
  cumulativeLastYearRevenue BigInt?   @map("cumulative_last_year_revenue")
  cumulativeChangePercent   Decimal?  @map("cumulative_change_percent") @db.Decimal(10, 4)
  note                      String?

  @@map("monthly_revenue")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 處置股票（上櫃版本）——欄位比 TWSE 精簡，沒有 announcement_count/disposition_measures/
/// link_information。
view DisposedStock {
  symbol            String?
  announceDate      DateTime? @map("announce_date") @db.Date
  reason            String?
  dispositionPeriod String?   @map("disposition_period")
  detail            String?

  @@map("disposed_stock")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 上櫃成交量前 20 名——欄位比 TWSE 精簡許多，只有 symbol/trade_date/rank/volume，沒有
/// transaction/open/high/low/close/dir/change。
view VolumeTop20 {
  symbol    String?
  tradeDate DateTime? @map("trade_date") @db.Date
  rank      Int?
  volume    BigInt?

  @@map("volume_top20")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 上櫃個股漲跌停幅度最大/最小各 20 檔——欄位比 TWSE 精簡，沒有 opening_ref_price/
/// previous_day_price/allow_odd_lot_trade。
view PriceLimitRange {
  symbol      String?
  tradeDate   DateTime? @map("trade_date") @db.Date
  rankGroup   String?   @map("rank_group") // 'top'（幅度最大）/ 'bottom'（幅度最小）
  rank        Int?
  limitUp     Decimal?  @map("limit_up") @db.Decimal(10, 4)
  limitDown   Decimal?  @map("limit_down") @db.Decimal(10, 4)
  limitRange  Decimal?  @map("limit_range") @db.Decimal(10, 4)

  @@map("price_limit_range")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 注意股票累計次數異常（上櫃版本）——欄位跟 oingg-twse 那份完全一致。
view AttentionHistoryNote {
  symbol    String?
  tradeDate DateTime? @map("trade_date") @db.Date
  criteria  String?

  @@map("attention_history_note")
  @@ignore
  @@schema("export")
}
