// 2026-10-08 tpex-ts 把 export view 改名成 v_＋複數、不保留舊名（下面 @@map 已是新名；早已不存在的 price_limit_range 已刪）。
generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/tpex-export-client"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["export"]
}

model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String
  dataDate    DateTime @map("data_date") @db.Date
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  rowCount    Int      @map("row_count")
  status      String

  @@unique([dataset, dataDate])
  @@index([dataset, status])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 跟 oingg-twse 的 DailyValuation 是同一種資料（上櫃版本），欄位定義完全一致。
view DailyValuation {
  symbol        String?
  tradeDate     DateTime? @map("trade_date") @db.Date
  peRatio       Decimal?  @map("pe_ratio") @db.Decimal(10, 2)
  pbRatio       Decimal?  @map("pb_ratio") @db.Decimal(10, 2)
  dividendYield Decimal?  @map("dividend_yield") @db.Decimal(10, 2)

  @@map("v_daily_valuations")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 跟 oingg-twse 的 DailyPrice 幾乎同一種資料（上櫃版本），沒有 monthlyAvg 欄位，跟
/// prisma/tpex/schema.prisma（即將退休）的 DailyPrice 定義一致。
view DailyPrice {
  symbol      String?
  tradeDate   DateTime? @map("trade_date") @db.Date
  open        Decimal?  @db.Decimal(10, 4)
  high        Decimal?  @db.Decimal(10, 4)
  low         Decimal?  @db.Decimal(10, 4)
  close       Decimal?  @db.Decimal(10, 4)
  volume      BigInt?
  turnover    BigInt?
  transaction BigInt?

  @@map("v_daily_prices")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 只鏡像查公司名稱用得到的欄位，不是全部欄位都留，跟 prisma/tpex/schema.prisma（即將退休）
/// 的 CompanyProfile 做法一致，多了 source（上櫃/興櫃登記類別，值域 COMPANY_PROFILE/
/// COMPANY_PROFILE_EMERGING）備用。2026-09-04 tpex-ts 把這個欄位從 market 改名成
/// source（硬切、無過渡期）——原本叫 market 容易誤會成 TWSE/TPEx 市場別，實際存的是登記
/// 類別，見 UBIQUITOUS_LANGUAGE.md 的討論。
view CompanyProfile {
  symbol                       String?
  source                       String?
  report_date                  DateTime? @db.Date
  name                         String?
  shortName                    String?   @map("short_name")
  foreign_registration_country String?
  industry                     String?
  address                      String?
  tax_id                       String?
  chairman                     String?
  general_manager              String?
  spokesperson                 String?
  spokesperson_title           String?
  deputy_spokesperson          String?
  phone                        String?
  established_date             DateTime? @db.Date
  listed_date                  DateTime? @db.Date
  par_value                    Decimal?  @db.Decimal(14, 4)
  paid_in_capital              BigInt?
  private_placement_shares     BigInt?
  preferred_stock_shares       BigInt?
  financial_report_type        String?
  stock_transfer_agency        String?
  transfer_agency_phone        String?
  transfer_agency_address      String?
  auditing_firm                String?
  auditor1                     String?
  auditor2                     String?
  english_short_name           String?
  fax_number                   String?
  email                        String?
  website                      String?
  issued_shares                BigInt?
  created_at                   DateTime?
  updated_at                   DateTime?

  @@map("v_company_profiles")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 月營收（上櫃版本）——欄位跟 oingg-twse 那份完全一致。
view MonthlyRevenue {
  symbol                    String?
  yearMonth                 DateTime? @map("year_month") @db.Date
  reportDate                DateTime? @map("report_date") @db.Date
  industry                  String?
  currentMonthRevenue       BigInt?   @map("current_month_revenue")
  prevMonthRevenue          BigInt?   @map("prev_month_revenue")
  lastYearSameMonthRevenue  BigInt?   @map("last_year_same_month_revenue")
  momChangePercent          Decimal?  @map("mom_change_percent") @db.Decimal(14, 4)
  yoyChangePercent          Decimal?  @map("yoy_change_percent") @db.Decimal(14, 4)
  cumulativeRevenue         BigInt?   @map("cumulative_revenue")
  cumulativeLastYearRevenue BigInt?   @map("cumulative_last_year_revenue")
  cumulativeChangePercent   Decimal?  @map("cumulative_change_percent") @db.Decimal(14, 4)
  note                      String?

  @@map("v_monthly_revenues")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 處置股票（上櫃版本）——欄位比 TWSE 精簡，沒有 announcement_count/disposition_measures/
/// link_information。
view DisposedStock {
  symbol            String?
  announceDate      DateTime? @map("announce_date") @db.Date
  reason            String?
  dispositionPeriod String?   @map("disposition_period")
  detail            String?

  @@map("v_disposed_stocks")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 上櫃成交量前 20 名——欄位比 TWSE 精簡許多，只有 symbol/trade_date/rank/volume，沒有
/// transaction/open/high/low/close/dir/change。
view VolumeTop20 {
  symbol    String?
  tradeDate DateTime? @map("trade_date") @db.Date
  rank      Int?
  volume    BigInt?

  @@map("v_volume_top20_rankings")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 注意股票累計次數異常（上櫃版本）——欄位跟 oingg-twse 那份完全一致。
view AttentionHistoryNote {
  symbol    String?
  tradeDate DateTime? @map("trade_date") @db.Date
  criteria  String?

  @@map("v_attention_history_notes")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 融資融券餘額（source 是 tpex-ts 內部的 tpex_mainboard_margin_balance）——2026-09-04
/// 應要求開放，給券資比排行補上櫃市場。命名沿用 tpex-ts 內部習慣，沒有刻意對齊 twse-ts 的
/// margin_balance（後者欄位少很多，只有 margin_today_balance/short_today_balance）。
view MarginBalance {
  symbol               String?
  tradeDate            DateTime? @map("trade_date") @db.Date
  marginBuy            BigInt?   @map("margin_buy")
  marginSell           BigInt?   @map("margin_sell")
  marginCashRedemption BigInt?   @map("margin_cash_redemption")
  marginPrevBalance    BigInt?   @map("margin_prev_balance")
  marginTodayBalance   BigInt?   @map("margin_today_balance")
  marginLimit          BigInt?   @map("margin_limit")
  shortBuy             BigInt?   @map("short_buy")
  shortSell            BigInt?   @map("short_sell")
  shortCashRedemption  BigInt?   @map("short_cash_redemption")
  shortPrevBalance     BigInt?   @map("short_prev_balance")
  shortTodayBalance    BigInt?   @map("short_today_balance")
  shortLimit           BigInt?   @map("short_limit")
  offsetting           BigInt?
  note                 String?

  @@map("v_margin_balances")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 2026-09-04 接進 securities/excludeFullDelivery 了——altered_trading 直接代表全額交割，
/// 跟 periodic_trading（分盤集合競價）是兩個分開的欄位，不會混淆。TWSE 那邊沒有對應的
/// 布林欄位，改用「symbol 有沒有出現在最新一個 trade_date」判斷，見
/// src/shared/sourceData/companyProfile.ts 的 getFullDeliverySymbolSets。
view ChangedTradingMethod {
  symbol                 String?
  tradeDate              DateTime? @map("trade_date") @db.Date
  alteredTrading         Boolean?  @map("altered_trading")
  periodicTrading        Boolean?  @map("periodic_trading")
  managedStock           Boolean?  @map("managed_stock")
  matchingFrequency      String?   @map("matching_frequency")
  suspensionOfTrading    Boolean?  @map("suspension_of_trading")
  financialAnnouncements Boolean?  @map("financial_announcements")

  @@map("v_changed_trading_methods")
  @@ignore
  @@schema("export")
}
