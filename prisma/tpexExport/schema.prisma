// 本 schema 只用來讀 oingg-tpex-ts 的 export schema——2026-09-01 接上，dev/prod 連線用
// .env 的 TPEX_EXPORT_DATABASE_URL_DEV / TPEX_EXPORT_DATABASE_URL_PROD。
//
// 跟 sitca-ts 同一種模式：tpex-ts 給的是 dev/prod 兩個獨立 Neon 專案，不是同一個專案的
// pooler/direct 兩種連線方式——這裡的 datasource url 固定指到 _DEV，只給 `prisma db pull`/
// `generate` 這類 CLI 操作使用；實際 runtime 要連 dev 還是 prod，由
// src/adapters/prisma/tpexExportClient.ts 依照 config.isProduction 動態決定。
//
// 2026-09-01 這次擴大：發現本服務主程式原本讀 tpex 的 prisma/tpex/schema.prisma（public
// schema 唯讀鏡像）指向的其實是 tpex-ts 的 **dev** 環境（另一組帳號，不是 etl_reader），資料
// 停在 2024-08-20，遠比 prod 舊（prod 的 daily_valuation 新到 2026-08-31）——問過 tpex-ts 後，
// 他們選擇把 export schema 擴大成含 daily_price、company_profile（比照 daily_valuation
// 同樣走 etl_reader 唯讀、dev/prod 分流），讓本服務整個切過來，退休原本那組舊帳號
// （TPEX_DATABASE_URL/TPEX_DIRECT_URL、prisma/tpex/schema.prisma 之後會移除）。
//
// company_profile 只鏡像查公司名稱用得到的欄位（symbol/name/shortName/market），不是全部
// 欄位都留——市場別 market 是新欄位（上櫃/興櫃），tpex-ts 說明用這個欄位分辨，但本服務目前
// 沒有需要分辨市場別的地方，先留著備用。
//
// export.daily_price/daily_valuation 都是逐日整批同步（IngestionRun 顆粒度是「一個 dataset、
// 一天」），company_profile 是快照表，沒有對應的 ingestion_runs 紀錄（tpex-ts 說明：快照表
// 沒有 data_date 概念）。
//
// 這幾張 view 都沒有唯一識別欄位，Prisma Client 不會產生 model 存取子（@@ignore），查詢一律走
// $queryRaw。異動這裡的 model 後，重新跑 `npx prisma db pull --schema=prisma/tpexExport/schema.prisma`
// 內省，這個 schema 由 tpex-ts 擁有，本服務永遠不對它跑 migrate——內省後记得把 view 名稱/欄位
// 手動改回 PascalCase model 名稱 + camelCase 欄位。

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/tpex-export-client"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("TPEX_EXPORT_DATABASE_URL_DEV")
  directUrl = env("TPEX_EXPORT_DATABASE_URL_DEV")
  schemas   = ["export"]
}

// 握手表——見契約第二部分。daily_price/daily_valuation 顆粒度是「一個 dataset、一天」，全市場
// 整批同步，不是逐公司；company_profile 快照表沒有對應紀錄。
model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String
  dataDate    DateTime @map("data_date") @db.Date
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  rowCount    Int      @map("row_count")
  status      String // 'success' | 'partial' | 'failed'

  @@unique([dataset, dataDate])
  @@index([dataset, status])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 跟 oingg-twse 的 DailyValuation 是同一種資料（上櫃版本），欄位定義完全一致。
view DailyValuation {
  symbol        String?
  tradeDate     DateTime? @map("trade_date") @db.Date
  peRatio       Decimal?  @map("pe_ratio") @db.Decimal(10, 2)
  pbRatio       Decimal?  @map("pb_ratio") @db.Decimal(10, 2)
  dividendYield Decimal?  @map("dividend_yield") @db.Decimal(10, 2)

  @@map("daily_valuation")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 跟 oingg-twse 的 DailyPrice 幾乎同一種資料（上櫃版本），沒有 monthlyAvg 欄位，跟
/// prisma/tpex/schema.prisma（即將退休）的 DailyPrice 定義一致。
view DailyPrice {
  symbol      String?
  tradeDate   DateTime? @map("trade_date") @db.Date
  open        Decimal?  @db.Decimal(10, 4)
  high        Decimal?  @db.Decimal(10, 4)
  low         Decimal?  @db.Decimal(10, 4)
  close       Decimal?  @db.Decimal(10, 4)
  volume      BigInt?
  turnover    BigInt?
  transaction BigInt?

  @@map("daily_price")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 只鏡像查公司名稱用得到的欄位，不是全部欄位都留，跟 prisma/tpex/schema.prisma（即將退休）
/// 的 CompanyProfile 做法一致，多了 market（上櫃/興櫃）備用。
view CompanyProfile {
  symbol    String?
  name      String?
  shortName String? @map("short_name")
  market    String?

  @@map("company_profile")
  @@ignore
  @@schema("export")
}
