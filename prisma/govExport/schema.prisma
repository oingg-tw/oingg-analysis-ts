// 本 schema 只用來讀 oingg-gov-ts 的 export schema（不是 public schema，那個在 ../gov/schema.prisma）
// ——2026-08-31 gov-ts 建好 export.monthly_gov_bond_yield_10y view、export.ingestion_runs 握手表、
// etl_reader role（只能 SELECT export schema，實測驗證過連 INSERT/CREATE TABLE 都會被拒絕，
// 比 mops pilot 當初的驗證範圍更完整），連線用 .env 的 GOV_EXPORT_DATABASE_URL /
// GOV_EXPORT_DIRECT_URL。2026-09-01 再加上 export.company_industry_classification view
// （財政部稅籍登記的官方逐公司行業分類，見 CompanyIndustryClassification 的說明）。
//
// 跟 prisma/mopsExport/schema.prisma 同一種模式，見該檔案開頭的說明。
//
// 這幾張 view 都沒有唯一識別欄位，Prisma Client 不會產生 model 存取子（@@ignore），查詢一律走
// $queryRaw，見 src/shared/sync/govMonthlyGovBondYield10ySync.ts、
// src/shared/sync/govCompanyIndustryClassificationSync.ts。
//
// 異動這裡的 model 後，重新跑 `npx prisma db pull --schema=prisma/govExport/schema.prisma`
// 內省，這個 schema 由 gov-ts 擁有，本服務永遠不對它跑 migrate——內省後记得把 view 名稱/欄位
// 手動改回 PascalCase model 名稱 + camelCase 欄位（`prisma db pull` 對 view 預設用原始
// snake_case 名稱，跟本專案風格不一致，得手動調整）。

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/gov-export-client"
  previewFeatures = ["views"]
}

// Prisma 7：driver adapter 架構下 datasource 不再放連線字串，見
// src/adapters/prisma/govExportClient.ts、prisma.config.ts 的說明。
datasource db {
  provider = "postgresql"
  schemas  = ["export"]
}

// 握手表——見契約第二部分。gov-ts 這邊沒有公司代號維度（全市場單一時間序列/整批同步），顆粒度
// 由 data_date 代表這批資料涵蓋到哪個時間點。
model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String
  dataDate    DateTime @map("data_date") @db.Date
  completedAt DateTime @default(now()) @map("completed_at")
  rowCount    Int      @map("row_count")
  status      String // 'success' | 'partial' | 'failed'

  @@index([dataset, status])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
view MonthlyGovBondYield10y {
  year      Int?
  month     Int?
  yieldRate Decimal?  @map("yield_rate") @db.Decimal(8, 4)
  updatedAt DateTime? @map("updated_at")

  @@map("monthly_gov_bond_yield_10y")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// dataset='company_industry_classification' 是整批同步（一次全部公司一個 run，不是逐公司），
/// 跟 mops quarterly_income_statement 那種逐公司 run 不同，見 sync 檔案的說明。
view CompanyIndustryClassification {
  stockCode            String?   @map("stock_code")
  taxId                String?   @map("tax_id")
  industryCode         String?   @map("industry_code")
  sourceIndustryName   String?   @map("source_industry_name")
  sectionCode          String?   @map("section_code")
  divisionCode         String?   @map("division_code")
  groupCode            String?   @map("group_code")
  classCode            String?   @map("class_code")
  subclassCode         String?   @map("subclass_code")
  classificationNameZh String?   @map("classification_name_zh")
  updatedAt            DateTime? @map("updated_at")

  @@map("company_industry_classification")
  @@ignore
  @@schema("export")
}
