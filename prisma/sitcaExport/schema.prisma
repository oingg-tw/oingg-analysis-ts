// 本 schema 只用來讀 oingg-sitca-ts 的 export schema——2026-09-01 sitca-ts 建好
// export.fund_expense_ratio_annual/export.fund_lifecycle_event 兩個 view、
// export.ingestion_runs 握手表、etl_reader role（實測驗證過 7 項唯讀邊界：讀不到 export 以外
// 的 schema、INSERT/UPDATE/DELETE/CREATE TABLE 全部被拒絕，兩個 view 可正常 SELECT），連線用
// .env 的 SITCA_EXPORT_DATABASE_URL_DEV / SITCA_EXPORT_DATABASE_URL_PROD。
//
// sitca-ts 給的是 dev/prod 兩個獨立 Neon 專案，不是同一個專案的 pooler/direct 兩種連線方式——
// 這裡的 datasource url 固定指到 _DEV，只給 `prisma db pull`/`generate` 這類 CLI 操作使用；
// 實際 runtime 要連 dev 還是 prod，由 src/adapters/prisma/sitcaExportClient.ts 依照
// config.isProduction 動態決定（見該檔案說明），跟 mops/gov export 那種「單一連線、不分
// dev/prod」的模式不同。
//
// 2026-09-02 sitca-ts 又開了三個 ETF dataset（etf_basic_info/etf_monthly_statement/
// etf_performance），本服務用來做 GET /market/etf-ranking（見
// src/domains/market/etfRanking/）——規模/受益人數/淨申購贖回/定期定額/報酬率/總費用率
// 六種 metric 的排行。目前只有 202607 一個月的快照資料，之後累積更多月份才能做趨勢類指標。
//
// 這幾張 view 都沒有唯一識別欄位，Prisma Client 不會產生 model 存取子（@@ignore），查詢一律走
// $queryRaw。異動這裡的 model 後，重新跑 `npx prisma db pull --schema=prisma/sitcaExport/schema.prisma`
// 內省，這個 schema 由 sitca-ts 擁有，本服務永遠不對它跑 migrate。

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/sitca-export-client"
  previewFeatures = ["views"]
}

// Prisma 7：driver adapter 架構下 datasource 不再放連線字串，見
// src/adapters/prisma/sitcaExportClient.ts、prisma.config.ts 的說明。dev/prod 切換邏輯也是
// 應用程式碼決定，不是 schema 層級的事。
datasource db {
  provider = "postgresql"
  schemas  = ["export"]
}

// 握手表——見契約第二部分。sitca-ts 兩個 dataset 共用同一張 ingestion_runs，用 dataset 欄位區分。
model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String
  dataDate    DateTime @map("data_date") @db.Date
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  rowCount    BigInt   @map("row_count")
  status      String // 'success' | 'partial' | 'failed'

  @@index([dataset])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
view FundExpenseRatioAnnual {
  fundId              String?   @map("fund_id")
  year                Int?
  typeCode            String?   @map("type_code")
  fundName            String?   @map("fund_name")
  commissionAmount    BigInt?   @map("commission_amount")
  commissionRate      Decimal?  @map("commission_rate") @db.Decimal(8, 4)
  transactionTaxAmount BigInt?  @map("transaction_tax_amount")
  transactionTaxRate  Decimal?  @map("transaction_tax_rate") @db.Decimal(8, 4)
  etfTradingFeeAmount BigInt?   @map("etf_trading_fee_amount")
  etfTradingFeeRate   Decimal?  @map("etf_trading_fee_rate") @db.Decimal(8, 4)
  managementFeeAmount BigInt?   @map("management_fee_amount")
  managementFeeRate   Decimal?  @map("management_fee_rate") @db.Decimal(8, 4)
  custodianFeeAmount  BigInt?   @map("custodian_fee_amount")
  custodianFeeRate    Decimal?  @map("custodian_fee_rate") @db.Decimal(8, 4)
  guaranteeFeeAmount  BigInt?   @map("guarantee_fee_amount")
  guaranteeFeeRate    Decimal?  @map("guarantee_fee_rate") @db.Decimal(8, 4)
  otherFeeAmount      BigInt?   @map("other_fee_amount")
  otherFeeRate        Decimal?  @map("other_fee_rate") @db.Decimal(8, 4)
  totalAmount         BigInt?   @map("total_amount")
  totalRate           Decimal?  @map("total_rate") @db.Decimal(8, 4)
  fetchedAt           DateTime? @map("fetched_at")

  @@ignore
  @@map("fund_expense_ratio_annual")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
view FundLifecycleEvent {
  id              BigInt?
  fundId          String?   @map("fund_id")
  companyName     String?   @map("company_name")
  currentFundName String?   @map("current_fund_name")
  eventDate       DateTime? @map("event_date") @db.Date
  eventType       String?   @map("event_type")
  description     String?
  fetchedAt       DateTime? @map("fetched_at")

  @@ignore
  @@map("fund_lifecycle_event")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// ETF 基本資料——security_code + year_month 是概念上的鍵，established_date 是計算「總費用率
/// 排行要不要納入這檔」的依據（見 etfRanking 的說明）。
view EtfBasicInfo {
  securityCode           String?   @map("security_code")
  yearMonth              String?   @map("year_month")
  memberCode             String?   @map("member_code")
  companyName            String?   @map("company_name")
  securityShortName      String?   @map("security_short_name")
  fundName               String?   @map("fund_name")
  establishedDate        DateTime? @map("established_date") @db.Date
  category               String?
  trackingIndex          String?   @map("tracking_index")
  distributionClassInfo  String?   @map("distribution_class_info")
  fetchedAt              DateTime? @map("fetched_at")

  @@ignore
  @@map("etf_basic_info")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// ETF 規模/淨值/受益人數/申贖——fundTaxId 可以 join 回 FundExpenseRatioAnnual.fundId
/// 抓總費用率。這裡只鏡像規模/籌碼面排行用得到的欄位，不是全部欄位都留（*_original 那些
/// 外幣原始金額欄位、currency 都跳過，本服務目前只用得到台幣計價的數字）。
view EtfMonthlyStatement {
  securityCode           String?  @map("security_code")
  yearMonth              String?  @map("year_month")
  fundTaxId              String?  @map("fund_tax_id")
  aumTwd                 BigInt?  @map("aum_twd")
  totalHolders           BigInt?  @map("total_holders")
  subscriptionAmountTwd  BigInt?  @map("subscription_amount_twd")
  redemptionAmountTwd    BigInt?  @map("redemption_amount_twd")
  dcaAmountTwd           BigInt?  @map("dca_amount_twd")

  @@ignore
  @@map("etf_monthly_statement")
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// ETF 各天期報酬率（百分比，累積報酬不是年化）。
view EtfPerformance {
  securityCode String?  @map("security_code")
  yearMonth    String?  @map("year_month")
  return3m     Decimal? @map("return_3m") @db.Decimal(10, 4)
  return6m     Decimal? @map("return_6m") @db.Decimal(10, 4)
  return1y     Decimal? @map("return_1y") @db.Decimal(10, 4)
  return2y     Decimal? @map("return_2y") @db.Decimal(10, 4)
  return3y     Decimal? @map("return_3y") @db.Decimal(10, 4)
  return5y     Decimal? @map("return_5y") @db.Decimal(10, 4)
  returnYtd    Decimal? @map("return_ytd") @db.Decimal(10, 4)
  return10y    Decimal? @map("return_10y") @db.Decimal(10, 4)

  @@ignore
  @@map("etf_performance")
  @@schema("export")
}
