  ownerEarningsPerShareQuarterlyAnnualized Decimal? @map("owner_earnings_per_share_quarterly_annualized") @db.Decimal(14, 4)
  ownerEarningsPerShareTtm                 Decimal? @map("owner_earnings_per_share_ttm") @db.Decimal(14, 4)

  netIncomeFieldUsed String? @map("net_income_field_used")
  netIncomeValue     BigInt? @map("net_income_value")
  netIncomeTtmValue  BigInt? @map("net_income_ttm_value") // 近四季加總；資料不齊則為 null

  depreciationAndAmortizationValue    BigInt? @map("depreciation_and_amortization_value")
  depreciationAndAmortizationTtmValue BigInt? @map("depreciation_and_amortization_ttm_value") // 近四季加總；資料不齊則為 null

