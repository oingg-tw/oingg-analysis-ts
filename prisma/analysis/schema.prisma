  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  sgrTtm Decimal? @map("sgr_ttm") @db.Decimal(10, 2)

  // 引用自 profitability_roe.roe_ttm_pct / profitability_dividend_payout_ratio.payout_ratio_ttm。
  roeTtmValue          Decimal? @map("roe_ttm_value") @db.Decimal(10, 2)
  payoutRatioTtmValue  Decimal? @map("payout_ratio_ttm_value") @db.Decimal(10, 2)

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("profitability_sgr")
}

// 營運現金流對淨利比計算結果——「流量/流量」比率，只有單季/TTM 兩種口徑，沒有年化
// （跟 InterestCoverageResult 同一種結構）。欄位對應
// src/domains/cashFlow/ocfToNetIncome/types.ts 的 OcfToNetIncomeResult。
model OcfToNetIncomeResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  ocfToNetIncomeQuarterly Decimal? @map("ocf_to_net_income_quarterly") @db.Decimal(14, 4)
