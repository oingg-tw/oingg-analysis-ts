  capitalExpendituresTtmValue BigInt? @map("capital_expenditures_ttm_value") // 近四季加總（負數）；資料不齊則為 null

  paidInShares               BigInt? @map("paid_in_shares")
  capitalStockEffectiveYear  Int?    @map("capital_stock_effective_year")
  capitalStockEffectiveMonth Int?    @map("capital_stock_effective_month")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("guru_owner_earnings")
}

// Beta（貝塔係數）計算結果——跟財務季度脫鉤的逐日指標，PK 用 symbol+as_of_date（基準日），
// 跟 MarketRatiosResult 同一種模式，不是 symbol+year+season+dataType+subsidiaryCompanyId。
// 欄位對應 src/domains/portfolio/beta/types.ts 的 BetaResult。
model BetaResult {
  symbol   String
  asOfDate DateTime @map("as_of_date") @db.Date

  beta1Y Decimal? @map("beta_1y") @db.Decimal(10, 4)
  beta2Y Decimal? @map("beta_2y") @db.Decimal(10, 4)
  beta5Y Decimal? @map("beta_5y") @db.Decimal(10, 4)

  // 各窗口實際用到的重疊交易日數（樣本數不足門檻時 beta 為 null，但這裡仍記錄實際天數方便追蹤）。
  observations1Y Int? @map("observations_1y")
  observations2Y Int? @map("observations_2y")
  observations5Y Int? @map("observations_5y")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, asOfDate])
  @@map("portfolio_beta")
}

// Altman Z-Score（原始版，5 變數加權模型）計算結果——2026-08-24 從 solvency 移到 guru 分類，
// 2026-08-26 實作。X4（市值/總負債）需要市值，來自 mops 的 daily_stock_price（目前只有 2330），
// 跟 BetaResult 同一個資料源。query 介面 year/season 選填，不給就自動抓最新一季，見
// src/domains/guru/altmanZScore/service.ts 的 resolveQuarter，跟其他指標「必填」不同。
model AltmanZScoreResult {
  symbol              String
  year                Int    @map("year")
  season              Int    @map("season")
  dataType            String @map("data_type")
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  zScore Decimal? @map("z_score") @db.Decimal(10, 4)

  // X1~X5 都是原始比率（不是百分比），跟 1.2/1.4/3.3/0.6/0.999 這組係數搭配使用。
  x1 Decimal? @map("x1") @db.Decimal(14, 6)
  x2 Decimal? @map("x2") @db.Decimal(14, 6)
  x3 Decimal? @map("x3") @db.Decimal(14, 6)
  x4 Decimal? @map("x4") @db.Decimal(14, 6)
  x5 Decimal? @map("x5") @db.Decimal(14, 6)

  marketCapValue     Decimal?  @map("market_cap_value") @db.Decimal(24, 4)
  marketCapTradeDate DateTime? @map("market_cap_trade_date") @db.Date

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("guru_altman_z_score")
}

// Piotroski F-Score（9 項二元訊號，跟去年同季比較）計算結果。
// score 刻意用 Decimal 存（雖然值一定是 0~9 的整數）——filterCatalogCheck.ts 判斷「可以拿來 filter
// 的計算結果」的規則是「型別是 Decimal 且不是 *Value 結尾」，用 Int 會跳出這個自動檢查網。
// 9 個訊號布林值不算「計算結果」（是中繼判斷，不是最終指標），型別維持 Boolean，不受這條規則影響。
// 欄位對應 src/domains/guru/piotroskiFScore/types.ts 的 PiotroskiFScoreResult。
model PiotroskiFScoreResult {
  symbol              String
  year                Int    @map("year")
  season              Int    @map("season")
  dataType            String @map("data_type")
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  score Decimal? @map("score") @db.Decimal(2, 0)

  positiveRoa            Boolean? @map("positive_roa")
  positiveCfo             Boolean? @map("positive_cfo")
  roaImproved             Boolean? @map("roa_improved")
  accrualQuality          Boolean? @map("accrual_quality")
  leverageDecreased       Boolean? @map("leverage_decreased")
  liquidityImproved       Boolean? @map("liquidity_improved")
  noDilution              Boolean? @map("no_dilution")
  grossMarginImproved     Boolean? @map("gross_margin_improved")
  assetTurnoverImproved   Boolean? @map("asset_turnover_improved")

  priorYear        Int?      @map("prior_year")
  priorSeason      Int?      @map("prior_season")
  priorReportDate  DateTime? @map("prior_report_date") @db.Date

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("guru_piotroski_f_score")
}

// Beneish M-Score（8 變量法務會計造假預警模型，跟去年同季比較，TATA 除外）計算結果。
// 欄位對應 src/domains/guru/beneishMScore/types.ts 的 BeneishMScoreResult。
model BeneishMScoreResult {
  symbol              String
  year                Int    @map("year")
  season              Int    @map("season")
  dataType            String @map("data_type")
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  mScore Decimal? @map("m_score") @db.Decimal(10, 4)

  dsri Decimal? @map("dsri") @db.Decimal(14, 4)
  gmi  Decimal? @map("gmi") @db.Decimal(14, 4)
  aqi  Decimal? @map("aqi") @db.Decimal(14, 4)
  sgi  Decimal? @map("sgi") @db.Decimal(14, 4)
  depi Decimal? @map("depi") @db.Decimal(14, 4)
  sgai Decimal? @map("sgai") @db.Decimal(14, 4)
  tata Decimal? @map("tata") @db.Decimal(14, 4)
  lvgi Decimal? @map("lvgi") @db.Decimal(14, 4)

  priorYear       Int?      @map("prior_year")
  priorSeason     Int?      @map("prior_season")
  priorReportDate DateTime? @map("prior_report_date") @db.Date

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("guru_beneish_m_score")
}

// 杜邦分析（3 步版：ROE = 淨利率 x 總資產週轉率 x 權益乘數）計算結果——本服務第二個純組裝型
// 複合指標（直接引用 margins/turnoverRatio/roe 已經算好的值，不重複查詢），歸類在 profitability
// 不是 guru（不是掛名特定投資人/學者的公式，是通用分析技巧）。
// 欄位對應 src/domains/profitability/dupont/types.ts 的 DupontResult。
model DupontResult {
  symbol              String
  year                Int    @map("year")
  season              Int    @map("season")
  dataType            String @map("data_type")
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  netProfitMarginQuarterly Decimal? @map("net_profit_margin_quarterly") @db.Decimal(10, 2)
  netProfitMarginTtm       Decimal? @map("net_profit_margin_ttm") @db.Decimal(10, 2)
  assetTurnoverQuarterly   Decimal? @map("asset_turnover_quarterly") @db.Decimal(14, 4)
  assetTurnoverTtm         Decimal? @map("asset_turnover_ttm") @db.Decimal(14, 4)
  equityMultiplier         Decimal? @map("equity_multiplier") @db.Decimal(14, 4)

  decomposedRoeQuarterlyPct Decimal? @map("decomposed_roe_quarterly_pct") @db.Decimal(10, 2)
  decomposedRoeTtmPct       Decimal? @map("decomposed_roe_ttm_pct") @db.Decimal(10, 2)
  actualRoeQuarterlyPct     Decimal? @map("actual_roe_quarterly_pct") @db.Decimal(10, 2)
  actualRoeTtmPct           Decimal? @map("actual_roe_ttm_pct") @db.Decimal(10, 2)

  totalAssetsValue BigInt? @map("total_assets_value")
  equityFieldUsed  String? @map("equity_field_used")
  equityValue      BigInt? @map("equity_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("profitability_dupont")
}
