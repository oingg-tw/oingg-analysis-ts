// 本 schema 定義的表由 oingg-analysis-ts（本服務）自己擁有 schema/migration，連到獨立的
// oingg-analysis Neon 專案（見專案根目錄 .env 的 ANALYSIS_DATABASE_URL / ANALYSIS_DIRECT_URL——
// 服務名跟 Neon 專案名很像但是兩個不同的東西，不要混淆）。
// 跟 ../schema.prisma（唯讀鏡像 oingg-mops-ts 的季度財報表）是完全不同的資料庫，不要混用連線。
//
// 這裡存的主要是「算完的投資指標結果」，每個指標各自一張表（ROE、PER、PBR…）。
//
// 2026-08-31~09-03 曾經試過「curated 層」（`curated_<backend>_<dataset>` 命名 + `sync_state`，
// 把各後台 export schema 的資料同步一份副本進來，指標服務只讀這份副本，不即時查對方 DB）。
// 使用者評估後認為現階段做數據中台的 curated 層太早，2026-09-03 全部退場——指標服務改回
// 直接查各後台的 export schema（`mopsExportPrisma`／`govExportPrisma`／`twseExportPrisma`／
// `tpexExportPrisma`／`sitcaExportPrisma`，見 src/adapters/prisma/），不在本服務內部落地副本。
// 如果之後要重啟這個方向，可以參考這次的設計（sync 協定見已刪除的 src/shared/sync/，git
// 歷史裡找得到）。
//
// 異動這裡的 model 後，用 `pnpm prisma:analysis:migrate` 產生/套用 migration（不要對
// ../schema.prisma 那份跑 migrate，那份永遠只用 db pull 內省）。
//
// 表名（@@map）命名規則：`<分類>_<指標>`，跟 src/domains 底下的分類資料夾一一對應（例如
// guru/ncav/ 對應 guru_ncav），不要加 `_result` 這種沒有識別意義的字尾。2026-08-20 從舊的
// `<指標>_result` 命名（例如 roe_result）統一改成這個規則；當指標名稱本身已經以分類開頭時
// （例如 turnover 分類底下的 turnoverRatio），不要重複疊字首（是 turnover_ratio，不是
// turnover_turnover_ratio）。Prisma model 名稱（RoeResult 這種）維持不變，只有實際的 SQL
// 表名（@@map）換了，所以這次改名完全不影響任何 TypeScript 程式碼——`analysisPrisma.roeResult`
// 這種呼叫方式照舊。

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/analysis-client"
}

// Prisma 7：driver adapter 架構下 datasource 不再放連線字串，見
// src/adapters/prisma/analysisClient.ts、prisma.config.ts 的說明。
datasource db {
  provider = "postgresql"
}

// PER/PBR/股利殖利率查詢結果——本服務第一個「不是自己算，而是直接採用外部資料源現成數字」的指標，
// 也是第一個不跟財務季度掛鉤的指標。PER/PBR 是逐日的市場資料（跟 daily_valuation 同一種時間刻度），
// 不是「某季度的數字」——一開始誤把它硬套進 symbol+year+season+dataType+subsidiaryCompanyId
// 那套季度查詢模板，查歷史季度會永遠查不到資料（市場資料的起始日晚於任何已報過的季度），
// 已改成用 symbol+tradeDate 做 PK，跟 oingg-twse daily_valuation 的資料顆粒度一致。
// 數值來自 oingg-twse，本服務不知道對方 EPS 用的口徑，跟自己算的 EPS/BVPS 不保證一致，不要拿來互相驗證。
// 欄位對應 src/domains/metrics/valuation/marketRatios/types.ts 的 MarketRatiosResult。
model MarketRatiosResult {
  symbol    String
  tradeDate DateTime @map("trade_date") @db.Date

  peRatio          Decimal? @map("pe_ratio") @db.Decimal(10, 2)
  pbRatio          Decimal? @map("pb_ratio") @db.Decimal(10, 2)
  dividendYieldPct Decimal? @map("dividend_yield_pct") @db.Decimal(10, 2)

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, tradeDate])
  @@map("valuation_market_ratios")
}

// Beta（貝塔係數）計算結果——跟財務季度脫鉤的逐日指標，PK 用 symbol+trade_date（基準日），
// 跟 MarketRatiosResult 同一種模式，不是 symbol+year+season+dataType+subsidiaryCompanyId。
// 欄位對應 src/domainMetrics/portfolio/beta/types.ts 的 BetaResult。
// 2026-09-04：DB 欄位從 as_of_date 改名 tradeDate/trade_date，跟其他 7 支 technicals +
// MarketRatiosResult 這些日資料型結果表統一（原本只有這張表叫 as_of_date，是同一服務內
// 唯一的命名例外，見 UBIQUITOUS_LANGUAGE.md）。對外 HTTP query 參數仍然叫
// asOfDate，不受這次改動影響——這純粹是 DB 內部欄位改名，migration 用手動改成 RENAME
// COLUMN，不是 drop+add，保留既有 1439 筆資料。
model BetaResult {
  symbol    String
  tradeDate DateTime @map("trade_date") @db.Date

  beta1Y Decimal? @map("beta_1y") @db.Decimal(10, 4)
  beta2Y Decimal? @map("beta_2y") @db.Decimal(10, 4)
  beta5Y Decimal? @map("beta_5y") @db.Decimal(10, 4)

  // 各窗口實際用到的重疊交易日數（樣本數不足門檻時 beta 為 null，但這裡仍記錄實際天數方便追蹤）。
  observations1Y Int? @map("observations_1y")
  observations2Y Int? @map("observations_2y")
  observations5Y Int? @map("observations_5y")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, tradeDate])
  @@map("portfolio_beta")
}

// 產業代碼對照表——不是本服務算出來的指標結果，是從外部服務（localhost:8081，dev 環境的 TWSE
// 產業代碼服務，見 src/shared/sourceData/industryCodes.ts）抓來的參考資料，所以不遵循上面「<分類>_<指標>」
// 的指標結果表命名規則，另外取名 reference_industry_code。存起來的目的是「抓不到的時候還有
// 上次抓到的可以頂著用」，不是要當成本服務自己的資料來源真相（那個永遠是 localhost:8081）。
model IndustryCode {
  code String @id // 兩碼產業代碼，例如 "24"
  name String // 中文產業名稱，例如 "半導體業"

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("reference_industry_code")
}

// 股權風險溢酬（Equity Risk Premium）——歷史法：TAIEX 年化報酬率 - 同期 10年期公債次級市場殖利率
// 平均值。跟公司無關（全市場單一數字），PK 用 window_start + window_end（YYYY-MM 字串），不是
// symbol/as_of_date——同一組起訖窗口重算會覆蓋同一列，不同起訖窗口各自一列，方便比較不同樣本期間。
// 欄位對應 src/domains/metrics/macro/equityRiskPremium/types.ts 的 EquityRiskPremiumResult。
// 2026-08-30 使用者用真實資料驗證過：5 年窗口（2021-09~2026-08）算出 ERP ≈ 21%，10 年窗口
// （2016-06~2026-06）≈ 17%，都明顯偏離文獻常見區間（4%~8%），原因是台股這幾年剛好處在單一段
// 極端多頭；27 年窗口（1999-01~2026-06，TAIEX 回填完成後）才落回 5.8%~7.9%，見 MIN_RELIABLE_MONTHS
// 的說明——這不是本服務的臆測，是這次開發過程中拿真實數字對照文獻得出的結論。
model EquityRiskPremiumResult {
  windowStart String @map("window_start") // YYYY-MM，樣本窗口第一個有資料的月份
  windowEnd   String @map("window_end") // YYYY-MM，樣本窗口最後一個有資料的月份

  months Int // 窗口內「TAIEX 與無風險利率都有資料」的月數，報酬率樣本數 = months - 1

  // 全部以百分比數字儲存（例如 5.80 代表 5.80%），跟 MonthlyGovBondYield10y.yieldRate 同一種單位慣例。
  marketReturnGeometric  Decimal? @map("market_return_geometric") @db.Decimal(8, 4)
  marketReturnArithmetic Decimal? @map("market_return_arithmetic") @db.Decimal(8, 4)
  avgRiskFreeRate        Decimal? @map("avg_risk_free_rate") @db.Decimal(8, 4)
  erpGeometric           Decimal? @map("erp_geometric") @db.Decimal(8, 4)
  erpArithmetic          Decimal? @map("erp_arithmetic") @db.Decimal(8, 4)

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([windowStart, windowEnd])
  @@map("macro_equity_risk_premium")
}

// ============================================================================
// 2026-09-05 新增：ROE spike——point-in-time 事實層(metric_values)/定義層
// (metric_definitions)，絞殺者模式第一步(docs/analysis-ts-spec-v0.2.md §10.2 步驟 2)。
// 跟上方所有 XxxResult model 完全獨立並存：RoeResult/profitability_roe 不受影響，
// 這次新增的管線(src/pitMetrics/)完全不寫 RoeResult。
//
// 命名決策(跟最初 DDL 草案不同的地方，是討論後的決定，不是隨意更動，見對話紀錄)：
// - 主鍵欄位用 symbol，不是 stock_no——對齊本檔案上方所有 model 的既有慣例。
// - fiscalYear 存西元年(民國+1911)，轉換只發生在 src/pitMetrics 邊界層，不滲透進
//   QuarterlyMetricQuery 或現有 36 支指標(它們的 year 繼續是民國年字串)。
// - basis/nullReason 用 String + zod(src/pitMetrics/metricBasis.ts)驗證，不用 Postgres
//   enum——docs/analysis-ts-spec-v0.2.md §4.3 明講 basis 字彙要能「擴充不動 schema」，
//   enum 加新值要跑 migration 違背這個設計目標。等字彙穩定、要進入多指標正式遷移(全市場
//   backfill)之前，補一個 DB CHECK 約束是比較便宜的補強時機(比真正的 enum 轉型省掉整張表
//   ALTER COLUMN TYPE 重寫)。
// - value 欄位就是算出來的最終數字，跟本檔案上方 45 張表 `*Value` 結尾(原始輸入回顯)的
//   慣例語意不同，只是剛好同名，活在完全不同的表。
// ============================================================================

// 指標定義層——這次只塞 1 筆(roe)，欄位設計成通用給之後其他指標遷入時不用改 schema。
// dependsOn 目前只能填現有原始欄位名稱(如 netIncomeAttributableToParent)，不是 canonical
// account_code(那套詞彙還不存在，見 spec v0.2 §6.1)，是暫時性做法。
model MetricDefinition {
  metricCode String @id @map("metric_code")

  // 口徑說明，給人看的，不是拿來給程式邏輯 parse 的結構化資料。
  formulaNote String @map("formula_note")

  // 這支指標允許哪些 basis('Q'|'CUM'|'TTM'|'Q_ANN'|'FY' 的子集)，寫入前用來擋
  // 「存量指標被拿去算 TTM」這類錯誤(spec v0.2 §5.5)。
  allowedBases String[] @map("allowed_bases")

  // 暫時性依賴清單，見上方檔頭說明。
  dependsOn String[] @map("depends_on")

  currentFormulaVersion Int @default(1) @map("current_formula_version") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  values MetricValue[]

  @@map("metric_definitions")
}

// 指標事實層——spike 範圍只會有 metric_code = 'roe' 的資料。
model MetricValue {
  // fiscalQuarter 未來給 FY 類 basis 用時允許 null，nullable 欄位不能進 Postgres
  // PRIMARY KEY，所以用 surrogate key，複合識別鍵另開 @@unique。
  id BigInt @id @default(autoincrement())

  symbol String

  metricCode String @map("metric_code")

  // 'Q' | 'CUM' | 'TTM' | 'Q_ANN' | 'FY'，應用層 zod 驗證見 src/pitMetrics/metricBasis.ts。
  basis String

  // 沿用本檔案上方 45 張表區分個體/合併報表的既有慣例，跟 fiscalYear/fiscalQuarter(西元)
  // 分開存——複合唯一鍵必須含這兩欄，否則同一家公司同一季的個體/合併 ROE 會撞在同一個座標。
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  fiscalYear    Int  @map("fiscal_year") @db.SmallInt // 西元年（民國 + 1911）
  fiscalQuarter Int? @map("fiscal_quarter") @db.SmallInt // 1~4；FY 類 basis 才是 null（ROE 這次不會用到 null）

  // 算出來的最終數字，跟本檔案上方 45 表 `*Value` 結尾（原始輸入回顯）語意不同，見檔頭說明。
  // null 代表算不出來，原因見 nullReason。
  value Decimal? @db.Decimal(24, 6)

  // 'missing_input' | 'zero_or_negative_denominator' | 'not_applicable_industry' | 'insufficient_history'
  // 只有 value 為 null 時才有意義；value 非 null 時應為 null。應用層 zod 驗證見 metricBasis.ts。
  nullReason String? @map("null_reason")

  // 該值最早可被市場知道的日期。Q/Q_ANN = 本季財報公告日；TTM 完整時 = 近四季公告日最大值；
  // TTM 不齊（value=null）時 = 主季自己的公告日。
  knowledgeDate DateTime @map("knowledge_date") @db.Date

  // true = knowledgeDate 是用 reportDate（財報期末日）頂替，不是真公告日，有 look-ahead
  // bias。見 src/shared/sourceData/reportAnnouncementDate.ts 的 PriceAnchorSource。目前
  // financial_report_announcement 只驗證過 2330/2887/6488 114 年度，其餘幾乎都會是 true。
  knowledgeDateIsFallback Boolean @map("knowledge_date_is_fallback")

  formulaVersion Int      @default(1) @map("formula_version") @db.SmallInt
  computedAt     DateTime @default(now()) @map("computed_at")

  metricDefinition MetricDefinition @relation(fields: [metricCode], references: [metricCode])

  // 複合識別鍵。fiscalQuarter 可為 null 時 Postgres UNIQUE 預設把多個 null 視為互不相同
  // （不是 NULLS NOT DISTINCT，Prisma 無原生語法表達）——ROE 這次恆有 fiscalQuarter 非
  // null，不受影響，是已知但刻意不處理的缺口，等真的有 FY 類 basis 指標遷入時再處理。
  @@unique([symbol, metricCode, basis, fiscalYear, fiscalQuarter, dataType, subsidiaryCompanyId, knowledgeDate], map: "metric_values_identity_key")
  @@index([symbol, metricCode, basis, fiscalYear, fiscalQuarter, dataType, subsidiaryCompanyId], map: "metric_values_latest_lookup")
  @@map("metric_values")
}

// ============================================================================
// P0 止血：上方 37 張指標結果表的 upsert 在真的覆蓋既有列之前，先把即將被蓋掉的舊值
// 存進這張 append-only 影子表，純粹是保險，不做任何回溯查詢/清理排程。攔截邏輯見
// src/adapters/prisma/upsertShadowExtension.ts。
// ============================================================================
model MetricUpsertShadow {
  id BigInt @id @default(autoincrement())

  modelName   String   @map("model_name") // Prisma model 名稱（PascalCase，如 "RoeResult"）
  primaryKey  Json     @map("primary_key") // 這次 upsert 呼叫的 args.where 原始內容
  previousRow Json     @map("previous_row") // 即將被蓋掉的完整舊列快照
  capturedAt  DateTime @default(now()) @map("captured_at")

  @@index([modelName, capturedAt])
  @@map("metric_upsert_shadow")
}
