  operatingCashFlowValue    BigInt? @map("operating_cash_flow_value")
  operatingCashFlowTtmValue BigInt? @map("operating_cash_flow_ttm_value") // 近四季加總；資料不齊則為 null
  netIncomeFieldUsed        String? @map("net_income_field_used")
  netIncomeValue            BigInt? @map("net_income_value")
  netIncomeTtmValue         BigInt? @map("net_income_ttm_value") // 近四季加總；資料不齊則為 null

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("cash_flow_ocf_to_net_income")
}

// 應計項目比率計算結果——分母用本季期末總資產（不是平均），跟 turnoverRatio 同一種刻意簡化。
// 欄位對應 src/domains/cashFlow/accrualsRatio/types.ts 的 AccrualsRatioResult。
model AccrualsRatioResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  accrualsRatioQuarterly           Decimal? @map("accruals_ratio_quarterly") @db.Decimal(10, 2)
  accrualsRatioQuarterlyAnnualized Decimal? @map("accruals_ratio_quarterly_annualized") @db.Decimal(10, 2)
  accrualsRatioTtm                 Decimal? @map("accruals_ratio_ttm") @db.Decimal(10, 2)

  netIncomeFieldUsed        String? @map("net_income_field_used")
  netIncomeValue             BigInt? @map("net_income_value")
  netIncomeTtmValue          BigInt? @map("net_income_ttm_value") // 近四季加總；資料不齊則為 null
  operatingCashFlowValue     BigInt? @map("operating_cash_flow_value")
  operatingCashFlowTtmValue  BigInt? @map("operating_cash_flow_ttm_value") // 近四季加總；資料不齊則為 null
  investingCashFlowValue     BigInt? @map("investing_cash_flow_value")
  investingCashFlowTtmValue  BigInt? @map("investing_cash_flow_ttm_value") // 近四季加總；資料不齊則為 null
  totalAssetsValue           BigInt? @map("total_assets_value") // 本季期末總資產（分母，用期末值）

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("cash_flow_accruals_ratio")
}

// ROCE 使用資本報酬率計算結果——跟 RoeResult/RoaResult 同一種單季/年化/TTM 三數值結構。
// 欄位對應 src/domains/profitability/roce/types.ts 的 RoceResult。
model RoceResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  roceQuarterlyPct           Decimal? @map("roce_quarterly_pct") @db.Decimal(10, 2)
  roceQuarterlyAnnualizedPct Decimal? @map("roce_quarterly_annualized_pct") @db.Decimal(10, 2)
  roceTtmPct                 Decimal? @map("roce_ttm_pct") @db.Decimal(10, 2)

  // EBIT = 稅前淨利 + 利息費用（跟 InterestCoverageResult/NetDebtToEbitdaResult 算法一致）。
  ebitValue            BigInt? @map("ebit_value")
  ebitTtmValue         BigInt? @map("ebit_ttm_value") // 近四季加總；資料不齊則為 null
  // 使用資本（Capital Employed）= 總資產 - 流動負債，期末餘額。
  capitalEmployedValue BigInt? @map("capital_employed_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("profitability_roce")
}

// ROIC 投入資本回報率計算結果——跟 RoeResult/RoaResult 同一種單季/年化/TTM 三數值結構。
// 欄位對應 src/domains/profitability/roic/types.ts 的 RoicResult。
model RoicResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  roicQuarterlyPct           Decimal? @map("roic_quarterly_pct") @db.Decimal(10, 2)
  roicQuarterlyAnnualizedPct Decimal? @map("roic_quarterly_annualized_pct") @db.Decimal(10, 2)
  roicTtmPct                 Decimal? @map("roic_ttm_pct") @db.Decimal(10, 2)

  // NOPAT = EBIT x (1 - 有效稅率)；稅前淨利為零或負數時無法計算。
  nopatValue    BigInt? @map("nopat_value")
  nopatTtmValue BigInt? @map("nopat_ttm_value") // 近四季各季 NOPAT 加總；資料不齊則為 null

  // 投入資本 = 有息負債（短期借款+應付公司債+長期借款） + 權益 - 現金及約當現金，期末餘額。
  investedCapitalValue BigInt? @map("invested_capital_value")
  equityFieldUsed      String? @map("equity_field_used")
  equityValue          BigInt? @map("equity_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("profitability_roic")
}

// 巴菲特股東盈餘（每股）計算結果——跟 CashFlowPerShareResult 同一種單季/年化/TTM 三數值結構，
