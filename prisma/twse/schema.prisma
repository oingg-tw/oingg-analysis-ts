// 本 schema 只用來「讀」oingg-twse 擁有的表格（股價資料）。這些表的定義與 migration 一律由
// oingg-twse 那個服務負責，這裡永遠不要對它們跑 `prisma migrate`——欄位是用 `prisma db pull`
// 從既有資料庫內省後，依照本專案的 camelCase + `@map` 命名風格手動整理過。如果 oingg-twse
// 那邊改了 schema，重新跑一次 `prisma db pull --schema=prisma/twse/schema.prisma` 內省、
// 再對照調整即可。
//
// 2026-08-30 用 information_schema 現查過一次，oingg-twse 實際上還有 attention_stock、
// company_profile、company_status、foreign_holding、margin_balance、material_announcement、
// twse_raw 等表，目前鏡像了 daily_price（股價）、daily_valuation（已經算好的 PER/PBR/殖利率，
// 2026-08-19 拍板直接採用這張表現成的數字，不自己用 EPS/BVPS 重算，見
// src/domains/metrics/valuation/marketRatios/）、daily_taiex_index（大盤加權指數，Beta 計算的市場報酬率
// 來源，見 src/domains/metrics/portfolio/beta/）、company_profile（2026-09-01 只鏡像 symbol/
// name/shortName 三個欄位，只為了查公司名稱，見 src/shared/companyNameMiddleware.ts——不是把
// company_profile 全部欄位都搬進來，那是之後 securityInfo/ 領域真的要做時才需要的範圍）。
// 2026-09-01 應使用者要求，再加上 foreign_holding（外資持股，只鏡像算「加碼/減碼排行」用得到
// 的欄位）、margin_balance（融資融券餘額，只鏡像算「券資比排行」用得到的欄位），見
// src/domains/market/ 底下兩個排行功能。
// 其餘表用途跟資料來源都還不清楚，先不鏡像進來，需要時再補。

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/twse-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("TWSE_DATABASE_URL")
  directUrl = env("TWSE_DIRECT_URL")
}

// 每日股價——本服務目前完全沒有市場價格資料，valuation 分類（PER、PBR、市值等）卡的就是這個。
// 這張表的欄位在資料庫裡本來就是 camelCase（不是 snake_case），所以不需要 @map。
model DailyPrice {
  symbol      String
  tradeDate   DateTime @db.Date
  open        Decimal? @db.Decimal(10, 4)
  high        Decimal? @db.Decimal(10, 4)
  low         Decimal? @db.Decimal(10, 4)
  close       Decimal? @db.Decimal(10, 4)
  volume      BigInt?
  turnover    BigInt?
  transaction BigInt?
  monthlyAvg  Decimal? @db.Decimal(10, 4)

  @@id([symbol, tradeDate])
  @@map("daily_price")
}

// 每日估值比率——oingg-twse 已經算好的 PER/PBR/殖利率，本服務直接採用，不自己重算。
// 這張表的欄位在資料庫裡本來就是 camelCase（不是 snake_case），所以不需要 @map。
// 注意：EPS 用的是什麼口徑（單季/TTM/年度）不清楚，是外部黑盒數字，跟本服務自己算的 EPS/BVPS
// 口徑不保證一致，見 src/domains/metrics/valuation/marketRatios/ 的說明。
model DailyValuation {
  symbol        String
  tradeDate     DateTime @db.Date
  peRatio       Decimal? @db.Decimal(10, 2)
  pbRatio       Decimal? @db.Decimal(10, 2)
  dividendYield Decimal? @db.Decimal(10, 2)

  @@id([symbol, tradeDate])
  @@map("daily_valuation")
}

// 每日大盤加權指數（不分股票，全市場一份）——Beta = Cov(個股報酬率, 這張表的報酬率) / Var(...)
// 的市場報酬率來源，取代 oingg-mops-ts 已消失的 daily_market_index，見 src/domains/metrics/portfolio/beta/。
// 這張表的欄位在資料庫裡本來就是 camelCase（不是 snake_case），所以不需要 @map。
model DailyTaiexIndex {
  tradeDate DateTime @db.Date
  open      Decimal? @db.Decimal(10, 2)
  high      Decimal? @db.Decimal(10, 2)
  low       Decimal? @db.Decimal(10, 2)
  close     Decimal? @db.Decimal(10, 2)

  @@id([tradeDate])
  @@map("daily_taiex_index")
}

// 公司基本資料——這裡只鏡像查公司名稱用得到的三個欄位（symbol/name/shortName），不是
// company_profile 的全部欄位，見上方檔案開頭說明。這張表的欄位是 snake_case，需要 @map。
model CompanyProfile {
  symbol    String
  name      String? // 公司全名，例如「台灣積體電路製造股份有限公司」
  shortName String? @map("short_name") // 常用簡稱，例如「台積電」，給使用者看用這個

  @@id([symbol])
  @@map("company_profile")
}

// 外資持股——只鏡像「加碼/減碼排行」用得到的欄位：sharesHeldPercent 是外資持股佔已發行股數的
// 比例（%），排行看的是這個比例逐日變動的百分點，不是持股張數本身的變動幅度（張數變動會被
// 增減資干擾，比例才是市場慣用的「外資加碼/減碼」定義）。這張表的欄位是 snake_case，需要 @map。
model ForeignHolding {
  symbol            String
  tradeDate         DateTime @map("trade_date") @db.Date
  sharesHeld        BigInt   @map("shares_held")
  sharesHeldPercent Decimal  @map("shares_held_percent") @db.Decimal(10, 2)

  @@id([symbol, tradeDate])
  @@map("foreign_holding")
}

// 融資融券餘額——只鏡像「券資比排行」用得到的欄位：券資比 = 融券今日餘額 / 融資今日餘額，
// 是籌碼面「軋空/放空熱度」的常用指標。這張表的欄位是 snake_case，需要 @map。
model MarginBalance {
  symbol             String
  tradeDate          DateTime @map("trade_date") @db.Date
  marginTodayBalance BigInt?  @map("margin_today_balance")
  shortTodayBalance  BigInt?  @map("short_today_balance")

  @@id([symbol, tradeDate])
  @@map("margin_balance")
}
