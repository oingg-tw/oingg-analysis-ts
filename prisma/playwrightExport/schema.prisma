// 本 schema 只用來讀 oingg-playwright-py 的 export schema——2026-09-14 playwright-py
// 建好 export.company_category_summary view（供應鏈分類眾數彙整，每家上市櫃公司一列）、
// export.category_groups view（33 細分類→10 組粗分類對照表，playwright-py 自己設計的
// 「產業相似度」分組，不是 TWSE 官方 37 類）、etl_reader role（只能 SELECT export
// schema，一次性授權到位，之後陸續加新 view 不用重新談連線——這個 schema 預期會像
// gov-ts/mops-ts/twse-ts 那樣持續累加，不是只服務 findPeerGroup 這一個功能），連線用
// .env 的 PLAYWRIGHT_EXPORT_DATABASE_URL / PLAYWRIGHT_EXPORT_DIRECT_URL。
//
// 跟 prisma/govExport/schema.prisma 同一種模式，見該檔案開頭的說明。沒有 IngestionRun
// 握手表（playwright-py 這批 view 是即時算出來的彙整結果，不是逐批 ETL 同步，沒有「這批
// 資料涵蓋到哪個時間點」這個概念，company_category_summary 自己的 updated_at 欄位已經
// 夠用，不需要另外的握手表）。
//
// 這兩張 view 都沒有唯一識別欄位，Prisma Client 不會產生 model 存取子（@@ignore），查詢
// 一律走 $queryRaw，見 src/shared/sourceData/industryChainClassification.ts。
//
// 異動這裡的 model 後，重新跑 `npx prisma db pull --schema=prisma/playwrightExport/schema.prisma`
// 內省，這個 schema 由 playwright-py 擁有，本服務永遠不對它跑 migrate——內省後記得把 view
// 名稱/欄位手動改回 PascalCase model 名稱 + camelCase 欄位（`prisma db pull` 對 view 預設用
// 原始 snake_case 名稱，跟本專案風格不一致，得手動調整），並把 `db pull` 清掉的一般 `//`
// 註解手動補回來（同一個坑見 govExport/schema.prisma 2026-09-04 的教訓）。

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/playwright-export-client"
  previewFeatures = ["views"]
}

// Prisma 7：driver adapter 架構下 datasource 不再放連線字串，見
// src/adapters/prisma/playwrightExportClient.ts、prisma.config.ts 的說明。
datasource db {
  provider = "postgresql"
  schemas  = ["export"]
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 一家上市櫃公司一列，含 category 是 null 的公司（供應鏈報告裡完全沒有已分類的邊，
/// 2026-09-14 實測 1984 家裡有 265 家），不要在查詢時濾掉 null，由消費端判斷 found:false。
/// category = 33 細分類裡的眾數（供應方 from_code 出現次數最多的 product_category）；
/// confidence = categoryCount/sampleSize；sampleSize=0 時 category/confidence 皆為 null。
view CompanyCategorySummary {
  code          String?
  name          String?
  category      String?
  categoryCount BigInt?  @map("category_count")
  sampleSize    Decimal? @map("sample_size") @db.Decimal
  confidence    Decimal? @db.Decimal
  coarseGroup   String?  @map("coarse_group")
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("company_category_summary")
  @@ignore
  @@schema("export")
}

/// 沒有唯一識別欄位，Prisma Client 不會產生存取子，僅供對照欄位形狀，實際查詢走 $queryRaw。
/// 33 細分類 -> 10 組粗分類的 membership 對照表，一組 membership 一列（33 列）。
/// playwright-py 自己設計的「業務性質相近」分組，跟供應鏈上下游方向無關（不是
/// category_hierarchy 那套 tiers），也不是套用 TWSE 官方 37 類。
view CategoryGroup {
  coarseGroup  String? @map("coarse_group")
  fineCategory String? @map("fine_category")

  @@map("category_groups")
  @@ignore
  @@schema("export")
}
