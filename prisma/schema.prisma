generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model QuarterlyIncomeStatement {
  symbol                                  String
  year                                    Int
  quarter                                 Int
  dataType                                String   @map("data_type")
  subsidiaryCompanyId                     String   @default("") @map("subsidiary_company_id")
  reportDate                              DateTime @map("report_date") @db.Date
  operatingRevenue                        BigInt?  @map("operating_revenue")
  grossProfit                             BigInt?  @map("gross_profit")
  operatingIncome                         BigInt?  @map("operating_income")
  profitBeforeTax                         BigInt?  @map("profit_before_tax")
  netIncome                               BigInt?  @map("net_income")
  eps                                     Decimal? @map("eps") @db.Decimal(10, 2)
  createdAt                               DateTime @default(now()) @map("created_at")
  updatedAt                               DateTime @default(now()) @map("updated_at")
  adminExpenses                           BigInt?  @map("admin_expenses")
  comprehensiveIncomeAttributableToNci    BigInt?  @map("comprehensive_income_attributable_to_nci")
  comprehensiveIncomeAttributableToParent BigInt?  @map("comprehensive_income_attributable_to_parent")
  epsDiluted                              Decimal? @map("eps_diluted") @db.Decimal(10, 2)
  financeCosts                            BigInt?  @map("finance_costs")
  grossProfitBeforeAdjustment             BigInt?  @map("gross_profit_before_adjustment")
  incomeTaxExpense                        BigInt?  @map("income_tax_expense")
  interestIncome                          BigInt?  @map("interest_income")
  netIncomeAttributableToNci              BigInt?  @map("net_income_attributable_to_nci")
  netIncomeAttributableToParent           BigInt?  @map("net_income_attributable_to_parent")
  netIncomeFromContinuingOps              BigInt?  @map("net_income_from_continuing_ops")
  nonOperatingIncomeExpenses              BigInt?  @map("non_operating_income_expenses")
  operatingCost                           BigInt?  @map("operating_cost")
  operatingExpenses                       BigInt?  @map("operating_expenses")
  otherComprehensiveIncome                BigInt?  @map("other_comprehensive_income")
  otherIncome                             BigInt?  @map("other_income")
  otherNonOperatingGainsLosses            BigInt?  @map("other_non_operating_gains_losses")
  otherOperatingGainsLosses               BigInt?  @map("other_operating_gains_losses")
  rdExpenses                              BigInt?  @map("rd_expenses")
  sellingExpenses                         BigInt?  @map("selling_expenses")
  shareOfAssociatesJvProfit               BigInt?  @map("share_of_associates_jv_profit")
  totalComprehensiveIncome                BigInt?  @map("total_comprehensive_income")

  @@id([symbol, year, quarter, dataType, subsidiaryCompanyId])
  @@map("quarterly_income_statement")
}

model QuarterlyBalanceSheet {
  symbol                       String
  year                         Int
  quarter                      Int
  dataType                     String   @map("data_type")
  subsidiaryCompanyId          String   @default("") @map("subsidiary_company_id")
  reportDate                   DateTime @map("report_date") @db.Date
  cashAndEquivalents           BigInt?  @map("cash_and_equivalents")
  accountsReceivable           BigInt?  @map("accounts_receivable")
  inventory                    BigInt?  @map("inventory")
  currentAssets                BigInt?  @map("current_assets")
  propertyPlantEquipment       BigInt?  @map("property_plant_equipment")
  investmentsUnderEquityMethod BigInt?  @map("investments_under_equity_method")
  intangibleAssets             BigInt?  @map("intangible_assets")
  nonCurrentAssets             BigInt?  @map("non_current_assets")
  totalAssets                  BigInt?  @map("total_assets")
  shortTermBorrowings          BigInt?  @map("short_term_borrowings")
  accountsPayable              BigInt?  @map("accounts_payable")
  currentLiabilities           BigInt?  @map("current_liabilities")
  bondsPayable                 BigInt?  @map("bonds_payable")
  longTermBorrowings           BigInt?  @map("long_term_borrowings")
  nonCurrentLiabilities        BigInt?  @map("non_current_liabilities")
  totalLiabilities             BigInt?  @map("total_liabilities")
  capitalStock                 BigInt?  @map("capital_stock")
  // 特別股分兩種：分類為權益的（preferredStockCapital）跟分類為金融負債的（preferredStockLiability，
  // 通常是可贖回特別股，依 IFRS 分類為負債）。preferredStockLiability 已經算在 totalLiabilities 裡面，
  // 不要重複扣——NCAV 只需要扣 preferredStockCapital。用台積電（2330）/2887 實測驗證過
  // totalLiabilities + totalEquity = totalAssets 這個恆等式成立，證實 preferredStockLiability
  // 沒有被排除在 totalLiabilities 之外。
  preferredStockCapital        BigInt?  @map("preferred_stock_capital")
  preferredStockLiability      BigInt?  @map("preferred_stock_liability")
  capitalSurplus               BigInt?  @map("capital_surplus")
  retainedEarnings             BigInt?  @map("retained_earnings")
  otherEquity                  BigInt?  @map("other_equity")
  treasuryStock                BigInt?  @map("treasury_stock")
  equityAttributableToParent   BigInt?  @map("equity_attributable_to_parent")
  nonControllingInterest       BigInt?  @map("non_controlling_interest")
  totalEquity                  BigInt?  @map("total_equity")
  totalLiabilitiesAndEquity    BigInt?  @map("total_liabilities_and_equity")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @default(now()) @map("updated_at")

  @@id([symbol, year, quarter, dataType, subsidiaryCompanyId])
  @@map("quarterly_balance_sheet")
}

model QuarterlyCashFlowStatement {
  symbol                         String
  year                           Int
  quarter                        Int
  dataType                       String   @map("data_type")
  subsidiaryCompanyId            String   @default("") @map("subsidiary_company_id")
  reportDate                     DateTime @map("report_date") @db.Date
  profitBeforeTax                BigInt?  @map("profit_before_tax")
  depreciation                   BigInt?  @map("depreciation")
  amortization                   BigInt?  @map("amortization")
  adjustmentsTotal               BigInt?  @map("adjustments_total")
  cashGeneratedFromOperations    BigInt?  @map("cash_generated_from_operations")
  incomeTaxPaid                  BigInt?  @map("income_tax_paid")
  netCashFromOperatingActivities BigInt?  @map("net_cash_from_operating_activities")
  capitalExpenditures            BigInt?  @map("capital_expenditures")
  proceedsFromDisposalOfPpe      BigInt?  @map("proceeds_from_disposal_of_ppe")
  acquisitionOfIntangibleAssets  BigInt?  @map("acquisition_of_intangible_assets")
  interestReceived               BigInt?  @map("interest_received")
  dividendsReceived              BigInt?  @map("dividends_received")
  netCashFromInvestingActivities BigInt?  @map("net_cash_from_investing_activities")
  proceedsFromBondsIssued        BigInt?  @map("proceeds_from_bonds_issued")
  repaymentOfBonds               BigInt?  @map("repayment_of_bonds")
  proceedsFromLongTermBorrowings BigInt?  @map("proceeds_from_long_term_borrowings")
  repaymentOfLongTermBorrowings  BigInt?  @map("repayment_of_long_term_borrowings")
  dividendsPaid                  BigInt?  @map("dividends_paid")
  interestPaid                   BigInt?  @map("interest_paid")
  netCashFromFinancingActivities BigInt?  @map("net_cash_from_financing_activities")
  exchangeRateEffect             BigInt?  @map("exchange_rate_effect")
  netIncreaseInCash              BigInt?  @map("net_increase_in_cash")
  cashBeginningBalance           BigInt?  @map("cash_beginning_balance")
  cashEndingBalance              BigInt?  @map("cash_ending_balance")
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @default(now()) @map("updated_at")
  cashPerBalanceSheet            BigInt?  @map("cash_per_balance_sheet")

  @@id([symbol, year, quarter, dataType, subsidiaryCompanyId])
  @@map("quarterly_cash_flow_statement")
}

model CapitalStockHistory {
  symbol                         String
  effectiveYear                  Int      @map("effective_year")
  effectiveMonth                 Int      @map("effective_month")
  licenseChangeYear              Int?     @map("license_change_year")
  licenseChangeMonth             Int?     @map("license_change_month")
  market                         String?
  parValue                       Decimal? @map("par_value") @db.Decimal(10, 4)
  authorizedShares               BigInt?  @map("authorized_shares")
  authorizedCapital              BigInt?  @map("authorized_capital")
  paidInShares                   BigInt?  @map("paid_in_shares")
  paidInCapital                  BigInt?  @map("paid_in_capital")
  sourceInitialCapital           BigInt?  @map("source_initial_capital")
  sourceCashIncrease             BigInt?  @map("source_cash_increase")
  sourceCapitalReserveTransfer   BigInt?  @map("source_capital_reserve_transfer")
  sourceRetainedEarningsTransfer BigInt?  @map("source_retained_earnings_transfer")
  capitalReserveApprovalDate     String?  @map("capital_reserve_approval_date")
  retainedEarningsApprovalDate   String?  @map("retained_earnings_approval_date")
  sourceMergerIncrease           BigInt?  @map("source_merger_increase")
  sourceCapitalReduction         BigInt?  @map("source_capital_reduction")
  mergerApprovalDate             String?  @map("merger_approval_date")
  capitalReductionApprovalDate   String?  @map("capital_reduction_approval_date")
  sourceOther                    String?  @map("source_other")
  nonCashContribution            String?  @map("non_cash_contribution")
  remarks                        String?
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @default(now()) @map("updated_at")

  @@id([symbol, effectiveYear, effectiveMonth])
  @@map("capital_stock_history")
}

model MonthlyCpi {
  year       Int
  month      Int
  indexValue Decimal  @map("index_value") @db.Decimal(8, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@id([year, month])
  @@map("monthly_cpi")
}

// 2026-08-30 移除：daily_market_index、daily_stock_price 這兩張表已經從 mops 資料庫裡消失
// （不是覆蓋率限制，是表本身不存在了，原因不明，可能是對方在重構）。市值/Beta 需要的股價、
// 大盤指數資料改用 oingg-twse 的 daily_price、daily_taiex_index（覆蓋率更完整，見
// src/shared/marketCap.ts、src/domains/portfolio/beta/service.ts 開頭的說明），
// src/ 底下已經沒有任何地方引用這兩個 model 了。

// 財報實際公告日——2026-08-28 發現存在，之前沒鏡像過。跟 quarterly_balance_sheet 等表的 reportDate
// 不一樣：reportDate 是財報涵蓋期間的「期末日」（會計期間，例如 114Q2 的 reportDate 是 2025-06-30），
// 這張表的 announcementDate 才是「市場真正知道這份財報數字的那一天」（依規定約在期末後 45 天，
// 2330 114Q2 期末 6/30、公告 8/12，差 43 天）。任何把股價/市值跟財報數字放在一起算的指標
// （Altman_Z_Score 的 X4、Beta、PSR/EV_EBITDA 這類）股價基準都應該用這張表的 announcementDate，
// 不能用 reportDate——用 reportDate 等於假設市場提早一個半月就知道財報結果，是 look-ahead bias。
// 純財務比率（ROE、DuPont 這類不牽涉股價的）繼續用 reportDate 排序 TTM/YoY，不受影響。
// **目前覆蓋範圍**：整張表 12 筆，負責 ingest 的服務已用 2330/2887/6488 三家公司 114 年度資料
// 驗證過（各 4/4 筆：114Q1~Q3 + 113 年報，0 警訊），是刻意先驗證這個範圍，不是漏抓；還沒涵蓋
// 到本服務常用測試季度 115Q2，查無資料時退回 reportDate，見 src/shared/reportAnnouncementDate.ts。
model FinancialReportAnnouncement {
  symbol           String
  fiscalYear       Int      @map("fiscal_year")
  fiscalQuarter    Int      @map("fiscal_quarter")
  dataType         String?  @map("data_type")
  announcementDate DateTime @map("announcement_date") @db.Date
  announcementTime String   @map("announcement_time")
  rawTitle         String   @map("raw_title")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@id([symbol, fiscalYear, fiscalQuarter])
  @@map("financial_report_announcement")
}

model dividend_distribution {
  symbol                              String
  rights_record_date                  DateTime  @db.Date
  company_name                        String?
  stock_dividend_from_earnings        Decimal?  @db.Decimal(12, 8)
  stock_dividend_from_capital_reserve Decimal?  @db.Decimal(12, 8)
  ex_rights_date                      DateTime? @db.Date
  cash_dividend_from_earnings         Decimal?  @db.Decimal(12, 8)
  cash_dividend_from_capital_reserve  Decimal?  @db.Decimal(12, 8)
  preferred_stock_cash_dividend       Decimal?  @db.Decimal(12, 8)
  ex_dividend_date                    DateTime? @db.Date
  cash_dividend_payment_date          DateTime? @db.Date
  capital_increase_shares             BigInt?
  capital_increase_subscription_ratio Decimal?  @db.Decimal(8, 4)
  capital_increase_subscription_price Decimal?  @db.Decimal(10, 4)
  total_participating_shares          BigInt?
  announcement_date                   DateTime? @db.Date
  announcement_time                   String?
  par_value                           Decimal?  @db.Decimal(10, 4)
  created_at                          DateTime  @default(now())
  updated_at                          DateTime  @default(now())
  fiscal_year                         Int?
  fiscal_quarter                      Int?

  @@id([symbol, rights_record_date])
}

model preferred_stock_right {
  symbol                                   String
  preferred_stock_code                     String
  series_no                                Int
  preferred_stock_name                     String?
  issue_date                               DateTime? @db.Date
  cumulative_dividend                      Boolean?
  issue_price                              Decimal?  @db.Decimal(10, 4)
  dividend_rate                            Decimal?  @db.Decimal(10, 4)
  participating_excess_dividend            Boolean?
  liquidation_preference                   Boolean?
  voting_rights                            Boolean?
  eligible_for_election                    Boolean?
  convertible                              Boolean?
  conversion_start_date                    DateTime? @db.Date
  redeemable                               Boolean?
  redemption_date                          DateTime? @db.Date
  redemption_conditions                    String?
  cash_capital_increase_subscription_right Boolean?
  earnings_capitalization_right            Boolean?
  asset_revaluation_surplus_right          Boolean?
  asset_disposal_surplus_right             Boolean?
  common_stock_premium_right               Boolean?
  modified_date                            DateTime? @db.Date
  previous_series_no                       Int?
  created_at                               DateTime  @default(now())
  updated_at                               DateTime  @default(now())

  @@id([symbol, preferred_stock_code, series_no])
}
